MONGODB_URI=mongodb://localhost:27017/portfolio
JWT_SECRET=your-jwt-secret
PORT=7000

# Google AI Studio — AI Mentor + resume upload parsing (https://aistudio.google.com/apikey)
GOOGLE_AI_API_KEY=your-google-ai-studio-api-key
GOOGLE_AI_MODEL=gemini-2.5-flash

# Cloudinary profile image uploads
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_PROFILE_FOLDER=portfolio/profile-images
# Optional: use an unsigned upload preset instead of API key/secret signing
# CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset

# Aliases also supported:
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# PayPal subscriptions (create products/plans in PayPal dashboard first)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_CREATOR_PLAN_ID=P-creator-plan-id
PAYPAL_PRO_PLAN_ID=P-pro-plan-id
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id
PAYPAL_BRAND_NAME=Portfolio Builder
FRONTEND_URL=http://localhost:3000

# Razorpay checkout (amounts are in paise for INR)
RAZORPAY_KEY_ID=rzp_test_your-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_CURRENCY=INR
RAZORPAY_CREATOR_AMOUNT_PAISE=120000
RAZORPAY_PRO_AMOUNT_PAISE=240000
RAZORPAY_BRAND_NAME=Portfolio Builder

# Set true to allow plan upgrades from Settings without payment in local demos
ALLOW_DEV_PLAN_UPGRADE=false
